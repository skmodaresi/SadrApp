<UserControl x:Class="SadrApp.Views.Pages.BankPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SadrApp.Views.Controls">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="PageTitle" Grid.Row="0" Style="{StaticResource H1}" Margin="0,0,0,10" Text="بانک‌ها، شعب و حساب‌ها"/>
    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="شعبه‌های بانک:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#44506B"/>
        <ComboBox x:Name="BankFilter" Width="220" Style="{StaticResource Combo}"/>
        <Button x:Name="BtnAccounts" Content="💰 حساب‌های بانکی" Style="{StaticResource GhostBtn}" Margin="10,0,0,0"/>
      </StackPanel>
    </Border>
    <controls:ListTableControl x:Name="ListCtl" Grid.Row="2"/>
  </Grid>
</UserControl>
