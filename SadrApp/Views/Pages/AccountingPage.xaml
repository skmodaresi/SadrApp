<UserControl x:Class="SadrApp.Views.Pages.AccountingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SadrApp.Views.Controls">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="PageTitle" Grid.Row="0" Style="{StaticResource H1}" Margin="0,0,0,10" Text="سطوح حسابداری"/>
    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="Filter1Label" Text="فیلتر:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#44506B"/>
        <ComboBox x:Name="Filter1" Width="260" Style="{StaticResource Combo}"/>
        <TextBlock x:Name="Filter2Label" Text="فیلتر:" VerticalAlignment="Center" Margin="14,0,6,0" Foreground="#44506B"/>
        <ComboBox x:Name="Filter2" Width="260" Style="{StaticResource Combo}"/>
      </StackPanel>
    </Border>
    <controls:ListTableControl x:Name="ListCtl" Grid.Row="2"/>
  </Grid>
</UserControl>
