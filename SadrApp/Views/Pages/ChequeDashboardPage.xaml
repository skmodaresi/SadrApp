<UserControl x:Class="SadrApp.Views.Pages.ChequeDashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Style="{StaticResource H1}" Margin="0,0,0,10" Text="داشبورد سررسید چک‌ها"/>

    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,8">
      <DockPanel LastChildFill="False">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="BtnPrevWeek" Content="◀ هفته قبل" Style="{StaticResource GhostBtn}"/>
          <TextBlock x:Name="TxtWeekLabel" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="14,0"/>
          <Button x:Name="BtnNextWeek" Content="هفته بعد ▶" Style="{StaticResource GhostBtn}"/>
          <Button x:Name="BtnThisWeek" Content="این هفته" Style="{StaticResource GhostBtn}" Margin="12,0,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <TextBlock Text="وصولی هفته:" VerticalAlignment="Center" Foreground="#44506B"/>
          <TextBlock x:Name="TxtWeekIn" Style="{StaticResource H2}" Margin="6,0,18,0" Foreground="#1F8A3D"/>
          <TextBlock Text="پرداختی هفته:" VerticalAlignment="Center" Foreground="#44506B"/>
          <TextBlock x:Name="TxtWeekOut" Style="{StaticResource H2}" Margin="6,0,0,0" Foreground="#D9534F"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border x:Name="OutlookCard" Grid.Row="2" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,8">
      <StackPanel x:Name="OutlookPanel"/>
    </Border>

    <Border x:Name="OverdueCard" Grid.Row="3" Background="#FFF6E8" BorderBrush="#E8C48A" BorderThickness="1"
            CornerRadius="8" Padding="10" Margin="0,0,0,8" Visibility="Collapsed">
      <StackPanel x:Name="OverduePanel"/>
    </Border>

    <Border Grid.Row="4" Background="White" CornerRadius="8" Padding="6" Margin="0,0,0,8">
      <DataGrid x:Name="DayGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                IsReadOnly="True" SelectionMode="Single" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                Background="Transparent" BorderThickness="0" RowHeight="34" FontSize="13"
                  ItemsSource="{Binding Days}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="روز" Binding="{Binding Label}" Width="*"/>
          <DataGridTextColumn Header="چک دریافتی" Binding="{Binding InCount}" Width="90"/>
          <DataGridTextColumn Header="وصولی" Binding="{Binding InTotal}" Width="150"/>
          <DataGridTextColumn Header="چک پرداختی" Binding="{Binding OutCount}" Width="90"/>
          <DataGridTextColumn Header="پرداختی" Binding="{Binding OutTotal}" Width="150"/>
          <DataGridTextColumn Header="وضعیت" Binding="{Binding Tag}" Width="100"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>

    <Border Grid.Row="5" Background="White" CornerRadius="8" Padding="6">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TxtDetailsTitle" Grid.Row="0" Style="{StaticResource H2}" Margin="8,6" Text="چک‌های روز انتخاب‌شده"/>
        <DataGrid x:Name="DetailGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" IsReadOnly="True" SelectionMode="Single" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column" Background="Transparent" BorderThickness="0" RowHeight="32" FontSize="13">
          <DataGrid.Columns>
            <DataGridTextColumn Header="شماره چک" Binding="{Binding Number}" Width="120"/>
            <DataGridTextColumn Header="مبلغ" Binding="{Binding Amount}" Width="150"/>
            <DataGridTextColumn Header="جهت" Binding="{Binding Direction}" Width="90"/>
            <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="110"/>
            <DataGridTextColumn Header="حساب بانکی" Binding="{Binding Account}" Width="*"/>
            <DataGridTextColumn Header="شخص / طرف حساب" Binding="{Binding Person}" Width="*"/>
            <DataGridTextColumn Header="توضیح" Binding="{Binding Note}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
