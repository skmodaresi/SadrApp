<UserControl x:Class="SadrApp.Views.Pages.BankAccountsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SadrApp.Views.Controls">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="PageTitle" Grid.Row="0" Style="{StaticResource H1}" Margin="0,0,0,10" Text="حساب‌های بانکی"/>
    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="بانک:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#44506B"/>
        <ComboBox x:Name="BankFilter" Width="220" Style="{StaticResource Combo}"/>
      </StackPanel>
    </Border>
    <controls:ListTableControl x:Name="ListCtl" Grid.Row="2"/>
    <Border x:Name="StatementCard" Grid.Row="3" Background="White" CornerRadius="8" Padding="10"
            Margin="0,8,0,0" Visibility="Collapsed">
      <StackPanel x:Name="StatementPanel"/>
    </Border>
  </Grid>
</UserControl>
