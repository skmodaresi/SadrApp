<UserControl x:Class="SadrApp.Views.Pages.BalancesDashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Style="{StaticResource H1}" Margin="0,0,0,10" Text="موجودی صندوق‌ها و حساب‌های بانکی"/>
    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="TxtCashTotal" VerticalAlignment="Center" Style="{StaticResource H2}"/>
        <TextBlock x:Name="TxtBankTotal" VerticalAlignment="Center" Style="{StaticResource H2}" Margin="28,0,0,0"/>
        <TextBlock x:Name="TxtGrandTotal" VerticalAlignment="Center" Style="{StaticResource H2}" Margin="28,0,0,0"/>
      </StackPanel>
    </Border>
    <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="6">
      <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                IsReadOnly="True" SelectionMode="Single" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                Background="Transparent" BorderThickness="0" RowHeight="34" FontSize="13">
        <DataGrid.Columns>
          <DataGridTextColumn Header="نوع" Binding="{Binding KindLabel}" Width="130"/>
          <DataGridTextColumn Header="نام" Binding="{Binding Name}" Width="*"/>
          <DataGridTextColumn Header="جزئیات" Binding="{Binding Detail}" Width="*"/>
          <DataGridTextColumn Header="موجودی اولیه" Binding="{Binding StartText}" Width="140"/>
          <DataGridTextColumn Header="موجودی فعلی" Binding="{Binding CurrentText}" Width="150"/>
        </DataGrid.Columns>
        <DataGrid.RowStyle>
          <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="Foreground" Value="{Binding RowColor}"/>
          </Style>
        </DataGrid.RowStyle>
      </DataGrid>
    </Border>
  </Grid>
</UserControl>
