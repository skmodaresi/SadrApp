<UserControl x:Class="SadrApp.Views.Pages.ChequesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SadrApp.Views.Controls">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="PageTitle" Grid.Row="0" Style="{StaticResource H1}" Margin="0,0,0,10" Text="مدیریت چک‌ها"/>
    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="جهت:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#44506B"/>
        <ComboBox x:Name="DirectionFilter" Width="170" Style="{StaticResource Combo}" Margin="0,0,16,0"/>
        <TextBlock Text="وضعیت:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#44506B"/>
        <ComboBox x:Name="StatusFilter" Width="170" Style="{StaticResource Combo}"/>
      </StackPanel>
    </Border>
    <controls:ListTableControl x:Name="ListCtl" Grid.Row="2"/>
    <StackPanel x:Name="QuickActionsBar" Grid.Row="2" Orientation="Horizontal"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,18">
      <StackPanel.Effect>
        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25"/>
      </StackPanel.Effect>
      <Button x:Name="BtnMarkCashed" Content="✅ وصول شد" Style="{StaticResource PrimaryBtn}" Margin="0,0,6,0" Padding="14,8" Visibility="Collapsed"/>
      <Button x:Name="BtnMarkBounced" Content="⚠️ برگشت خورده" Style="{StaticResource DangerBtn}" Margin="0,0,6,0" Padding="14,8" Visibility="Collapsed"/>
      <Button x:Name="BtnMarkSpent" Content="🔁 خرج شد" Style="{StaticResource GhostBtn}" Padding="14,8" Visibility="Collapsed"/>
    </StackPanel>
  </Grid>
</UserControl>
