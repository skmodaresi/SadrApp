<UserControl x:Class="SadrApp.Views.Pages.TaskListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SadrApp.Views.Controls">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="PageTitle" Grid.Row="0" Style="{StaticResource H1}" Margin="0,0,0,10"/>

    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,8">
      <DockPanel LastChildFill="False">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <TextBlock Text="پروژه:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#44506B"/>
          <ComboBox x:Name="CmbProject" Width="260" Margin="0,0,18,0"/>
          <TextBlock Text="وضعیت:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#44506B"/>
          <ComboBox x:Name="CmbStatus" Width="140"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <Button x:Name="BtnReports" Content="📋 گزارش‌های وظیفه" Style="{StaticResource GhostBtn}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <controls:ListTableControl x:Name="ListCtl" Grid.Row="2"/>
  </Grid>
</UserControl>
