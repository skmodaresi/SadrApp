<Window x:Class="SadrApp.Views.Controls.AccountsDialog"
        Icon="pack://application:,,,/Assets/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="حساب‌های بانکی" Height="520" Width="860"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterOwner"
        Background="#F3F5FA">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="حساب‌های بانکی" Style="{StaticResource H1}" Margin="0,0,0,10"/>
    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="BtnNew" Content="➕ حساب جدید" Style="{StaticResource PrimaryBtn}" Margin="0,0,6,0"/>
        <Button x:Name="BtnEdit" Content="✏️ ویرایش" Style="{StaticResource GhostBtn}" Margin="0,0,6,0"/>
        <Button x:Name="BtnDelete" Content="🗑 حذف" Style="{StaticResource DangerBtn}"/>
      </StackPanel>
    </Border>
    <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="4">
      <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                SelectionMode="Single" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                BorderThickness="0" RowHeight="34" FontSize="13">
        <DataGrid.Columns>
          <DataGridTextColumn Header="نام حساب" Binding="{Binding Title}" Width="*"/>
          <DataGridTextColumn Header="شماره حساب" Binding="{Binding Code}" Width="150"/>
          <DataGridTextColumn Header="مالک" Binding="{Binding Owner}" Width="150"/>
          <DataGridTextColumn Header="واحد پول" Binding="{Binding Currency}" Width="100"/>
          <DataGridTextColumn Header="موجودی فعلی" Binding="{Binding Balance}" Width="130"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </Grid>
</Window>
